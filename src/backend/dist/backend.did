type _ImmutableObjectStorageRefillResult = 
 record {
   success: opt bool;
   topped_up_amount: opt nat;
 };
type _ImmutableObjectStorageRefillInformation = record {
                                                  proposed_top_up_amount:
                                                   opt nat;};
type _ImmutableObjectStorageCreateCertificateResult = 
 record {
   blob_hash: text;
   method: text;
 };
type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type ScanRecord = 
 record {
   confidence: float64;
   description: text;
   diseaseName: text;
   expertAdvice: text;
   id: nat;
   imageUrl: ExternalBlob;
   organicSuggestions: vec text;
   prevention: vec text;
   severity: text;
   symptoms: vec text;
   timestamp: int;
   treatment: vec text;
   videoUrl: opt ExternalBlob;
 };
type ScanInput = 
 record {
   image: ExternalBlob;
   video: opt ExternalBlob;
 };
type Result__1 = 
 variant {
   err: Error;
   ok;
 };
type Result = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type ExternalBlob = blob;
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type DiseaseEntry = 
 record {
   causes: vec text;
   crop: text;
   imageUrl: ExternalBlob;
   name: text;
   prevention: vec text;
   symptoms: vec text;
   treatment: vec text;
 };
type ChatRole = 
 variant {
   assistant;
   user;
 };
type ChatMessage = 
 record {
   content: text;
   role: ChatRole;
   timestamp: int;
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
service : {
  _immutableObjectStorageBlobsAreLive: (hashes: vec blob) -> (vec bool) query;
  _immutableObjectStorageBlobsToDelete: () -> (vec blob) query;
  _immutableObjectStorageConfirmBlobDeletion: (blobs: vec blob) -> ();
  _immutableObjectStorageCreateCertificate: (blobHash: text) ->
   (_ImmutableObjectStorageCreateCertificateResult);
  _immutableObjectStorageRefillCashier: (refillInformation:
   opt _ImmutableObjectStorageRefillInformation) ->
   (_ImmutableObjectStorageRefillResult);
  _immutableObjectStorageUpdateGatewayPrincipals: () -> ();
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result__1);
  _internet_identity_sign_in_start: () -> (blob);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  createScan: (input: ScanInput) -> (ScanRecord);
  execute: (qJson: text) -> (Result) query;
  getApiDoc: () -> (text) query;
  getCallerUserRole: () -> (UserRole) query;
  getChatHistory: () -> (vec ChatMessage) query;
  getDiseases: () -> (vec DiseaseEntry) query;
  getDiseasesByCrop: (crop: text) -> (vec DiseaseEntry) query;
  getScan: (id: nat) -> (opt ScanRecord) query;
  isCallerAdmin: () -> (bool) query;
  listScans: () -> (vec ScanRecord) query;
  schema: () -> (text) query;
  searchDiseases: (searchTerm: text) -> (vec DiseaseEntry) query;
  sendChatMessage: (message: text) -> (ChatMessage);
}
